@import "tailwindcss";

:root {
  /* Brand */
  --electric: #38bdf8;
  --electric-bright: #7dd3fc;
  --electric-deep: #0284c7;
  --navy: #07111f;
  --navy-soft: #0b1729;
  --ink: #050a14;
  --silver: #c5cedb;
  --silver-muted: #8b97a8;
  --white: #f5f8fc;
  --glass: rgba(255, 255, 255, 0.045);
  --glass-border: rgba(125, 211, 252, 0.16);
  --glow: 0 0 40px rgba(56, 189, 248, 0.22);
  --glow-strong: 0 0 60px rgba(14, 165, 233, 0.35);
  --shadow-soft: 0 20px 50px rgba(0, 0, 0, 0.35);
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  --container: 1180px;
  --header-h: 76px;
  --section-y: clamp(4.5rem, 8vw, 7.5rem);
  --background: var(--ink);
  --foreground: var(--white);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-electric: var(--electric);
  --color-electric-bright: var(--electric-bright);
  --color-electric-deep: var(--electric-deep);
  --color-navy: var(--navy);
  --color-navy-soft: var(--navy-soft);
  --color-ink: var(--ink);
  --color-silver: var(--silver);
  --color-silver-muted: var(--silver-muted);
  --color-glass: var(--glass);
  --font-sans: var(--font-heebo);
  --shadow-glow: var(--glow);
  --shadow-glow-strong: var(--glow-strong);
  --radius-sm: var(--radius-sm);
  --radius-md: var(--radius-md);
  --radius-lg: var(--radius-lg);
  --radius-xl: var(--radius-xl);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-h) + 12px);
}

body {
  margin: 0;
  min-height: 100%;
  background:
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(14, 165, 233, 0.18), transparent 55%),
    radial-gradient(ellipse 50% 40% at 100% 20%, rgba(3, 105, 161, 0.12), transparent 50%),
    linear-gradient(180deg, #050a14 0%, #07111f 40%, #050a14 100%);
  color: var(--foreground);
  font-family: var(--font-heebo), "Assistant", system-ui, sans-serif;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

::selection {
  background: rgba(56, 189, 248, 0.35);
  color: white;
}

a {
  color: inherit;
  text-decoration: none;
}

img,
svg {
  max-width: 100%;
  height: auto;
  display: block;
}

button,
input,
select,
textarea {
  font: inherit;
}

:focus-visible {
  outline: 2px solid var(--electric);
  outline-offset: 3px;
}

.container-site {
  width: min(100% - 2rem, var(--container));
  margin-inline: auto;
}

.section-y {
  padding-block: var(--section-y);
}

.glass {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(14px);
  box-shadow: var(--shadow-soft);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 48px;
  padding: 0.75rem 1.4rem;
  border-radius: 999px;
  font-weight: 700;
  letter-spacing: 0.01em;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    color 0.25s ease;
  will-change: transform;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
  color: #041018;
  box-shadow: 0 10px 30px rgba(14, 165, 233, 0.28);
}

.btn-primary:hover {
  box-shadow: var(--glow-strong);
}

.btn-secondary {
  background: transparent;
  color: var(--white);
  border: 1px solid rgba(125, 211, 252, 0.35);
}

.btn-secondary:hover {
  border-color: var(--electric);
  background: rgba(56, 189, 248, 0.08);
  box-shadow: var(--glow);
}

.grid-bg {
  background-image:
    linear-gradient(rgba(125, 211, 252, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(125, 211, 252, 0.05) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
}

.circuit-line {
  stroke-dasharray: 4 10;
  animation: circuit-pulse 6s linear infinite;
}

@keyframes circuit-pulse {
  to {
    stroke-dashoffset: -80;
  }
}

@keyframes orbit {
  to {
    transform: rotate(360deg);
  }
}

@keyframes float-y {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.orbit {
  animation: orbit 28s linear infinite;
}

.float-soft {
  animation: float-y 5.5s ease-in-out infinite;
}

.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .orbit,
  .float-soft,
  .circuit-line {
    animation: none !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .btn:hover {
    transform: none;
  }
}
